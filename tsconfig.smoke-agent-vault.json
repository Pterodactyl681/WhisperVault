{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": ".smoke-dist",
    "rootDir": "."
  },
  "include": [
    "lib/agent-budget/**/*.ts",
    "lib/agent-plan/**/*.ts",
    "lib/agent-vault/**/*.ts",
    "lib/mirage/**/*.ts",
    "lib/whisperpay-server/**/*.ts",
    "scripts/agent-runtime-common.ts",
    "scripts/smoke-agent-vault.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
