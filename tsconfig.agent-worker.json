{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": ".agent-worker-dist",
    "rootDir": "."
  },
  "files": [
    "scripts/agent-worker.ts",
    "scripts/agent-worker-daemon.ts"
  ],
  "include": [
    "lib/agent-spend/**/*.ts",
    "lib/agent-worker/**/*.ts",
    "lib/execution-rails/**/*.ts",
    "lib/mirage/**/*.ts",
    "lib/solana-validation.ts",
    "lib/whisperpay-server/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
