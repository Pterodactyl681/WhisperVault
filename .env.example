# local keeps the existing file-backed/in-memory demo flow.
# database uses the Supabase Postgres-backed repository adapters.
STORAGE_MODE=local

# Runtime database adapter credentials for STORAGE_MODE=database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional for SQL migration tooling or future direct Postgres adapters.
DATABASE_URL=

# Keep offchain policy mode as the default for local and public devnet demos.
AGENT_BUDGET_POLICY_MODE=offchain

# Server-side Telegram bot credentials for webhook replies.
TELEGRAM_BOT_TOKEN=

# Optional webhook secret. When set, /api/telegram/webhook verifies
# X-Telegram-Bot-Api-Secret-Token against this value.
TELEGRAM_WEBHOOK_SECRET=

# Agent Worker control-plane URL and optional shared secret.
WHISPERVAULT_BASE_URL=http://localhost:3000
WHISPERVAULT_WORKER_SECRET=

# Local Mirage execution is disabled unless explicitly enabled.
AGENT_WALLET_NAME=agent-treasury
MIRAGE_EXECUTION_ENABLED=false
MIRAGE_EXECUTION_MODE=local
