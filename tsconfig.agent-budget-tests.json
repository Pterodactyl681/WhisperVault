{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": [
    "lib/agent-budget/**/*.ts",
    "lib/agent-plan/**/*.ts",
    "lib/agent-payment-lifecycle/**/*.ts",
    "lib/agent-vault/**/*.ts",
    "lib/mirage/**/*.ts",
    "lib/whisperpay-server/**/*.ts",
    "tests/agent-budget-service.test.ts",
    "tests/agent-budget-policy-adapter.test.ts",
    "tests/agent-budget-api.test.ts",
    "tests/agent-plan-api.test.ts",
    "tests/agent-payment-lifecycle.test.ts",
    "tests/mirage-command-generator.test.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
