{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": [
    "lib/agent-budget/**/*.ts",
    "lib/command-center/**/*.ts",
    "lib/agent-plan/**/*.ts",
    "lib/agent-registry/**/*.ts",
    "lib/agent-spend/**/*.ts",
    "lib/agent-worker/**/*.ts",
    "lib/ghost-tab/**/*.ts",
    "lib/agent-payment-lifecycle/**/*.ts",
    "lib/agent-vault/**/*.ts",
    "lib/telegram-link/**/*.ts",
    "lib/telegram/**/*.ts",
    "lib/demo-readiness/**/*.ts",
    "lib/execution-rails/**/*.ts",
    "lib/mirage/**/*.ts",
    "lib/whisperpay-server/**/*.ts",
    "tests/agent-budget-service.test.ts",
    "tests/agent-budget-policy-adapter.test.ts",
    "tests/agent-budget-api.test.ts",
    "tests/agent-plan-api.test.ts",
    "tests/command-center-api.test.ts",
    "tests/demo-readiness.test.ts",
    "tests/agent-registry.test.ts",
    "tests/ghost-tab-service.test.ts",
    "tests/agent-payment-lifecycle.test.ts",
    "tests/telegram-link-service.test.ts",
    "tests/telegram-link-api.test.ts",
    "tests/telegram-command-service.test.ts",
    "tests/telegram-webhook.test.ts",
    "tests/agent-worker.test.ts",
    "tests/agent-worker-daemon.test.ts",
    "tests/agent-worker-check.test.ts",
    "tests/storage-adapter.test.ts",
    "tests/mirage-command-generator.test.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
