{
  "name": "whisperpay-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:anchor-toolchain": "node scripts/check-anchor-toolchain.js",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test",
    "budget-vault:cargo-test": "cargo test -p budget_vault",
    "agent:coffee": "tsc -p tsconfig.agent-runtime.json && node --no-deprecation .agent-dist/scripts/agent-coffee.js",
    "agent:coffee:reject": "tsc -p tsconfig.agent-runtime.json && node --no-deprecation .agent-dist/scripts/agent-coffee-reject.js",
    "agent:worker": "tsc -p tsconfig.agent-worker.json && node .agent-worker-dist/scripts/agent-worker.js",
    "agent:worker:daemon": "tsc -p tsconfig.agent-worker.json && node .agent-worker-dist/scripts/agent-worker-daemon.js",
    "agent:worker:check": "node scripts/agent-worker-check.js",
    "agent:worker:dry-run": "tsc -p tsconfig.agent-worker.json && node .agent-worker-dist/scripts/agent-worker.js --dry-run",
    "demo:agent-vault:seed": "tsc -p tsconfig.demo-agent-vault.json && node .demo-dist/scripts/demo-agent-vault-seed.js",
    "demo:agent-vault:reset": "tsc -p tsconfig.demo-agent-vault.json && node .demo-dist/scripts/demo-agent-vault-reset.js",
    "demo:telegram:check": "node scripts/demo-telegram-check.js",
    "demo:windows": "scripts\\demo-whispervault-windows.cmd",
    "smoke:agent-vault": "tsc -p tsconfig.smoke-agent-vault.json && node .smoke-dist/scripts/smoke-agent-vault.js",
    "test": "npm run test:agent-budget",
    "test:agent-budget": "tsc -p tsconfig.agent-budget-tests.json && node .test-dist/tests/agent-budget-service.test.js && node .test-dist/tests/agent-budget-policy-adapter.test.js && node .test-dist/tests/agent-budget-api.test.js && node .test-dist/tests/agent-plan-api.test.js && node .test-dist/tests/agent-payment-lifecycle.test.js && node .test-dist/tests/telegram-link-service.test.js && node .test-dist/tests/telegram-link-api.test.js && node .test-dist/tests/telegram-command-service.test.js && node .test-dist/tests/telegram-webhook.test.js && node .test-dist/tests/agent-worker.test.js && node .test-dist/tests/agent-worker-daemon.test.js && node .test-dist/tests/agent-worker-check.test.js && node .test-dist/tests/storage-adapter.test.js && node .test-dist/tests/mirage-command-generator.test.js",
    "telegram:webhook:info": "node scripts/telegram-webhook-info.js",
    "telegram:set-webhook": "node scripts/telegram-set-webhook.js",
    "telegram:delete-webhook": "node scripts/telegram-delete-webhook.js"
  },
  "dependencies": {
    "@magicblock-labs/ephemeral-rollups-sdk": "^0.10.5",
    "@radix-ui/react-slot": "^1.1.1",
    "@solana/wallet-adapter-backpack": "^0.1.14",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-glow": "^0.1.18",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.32",
    "@solana/web3.js": "^1.98.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "magic-router-sdk": "^1.0.10",
    "next": "^14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
