{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": ".demo-dist",
    "rootDir": "."
  },
  "include": [
    "lib/agent-budget/**/*.ts",
    "scripts/demo-agent-vault-common.ts",
    "scripts/demo-agent-vault-seed.ts",
    "scripts/demo-agent-vault-reset.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
